# Copy this file to .env and change the values for your machine.
# PostgreSQL connection string (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/settleup
# Separate database used only by pytest (it is wiped by the tests!)
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/settleup_test
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
